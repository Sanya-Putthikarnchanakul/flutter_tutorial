{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "debug",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug"
    },
    {
      "name": "proxy android",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "args": [
        "--dart-define=useMitmProxy=true",
        "--dart-define=proxyUrl=10.0.2.2",
        "--dart-define=proxyPort=8080"
      ]
    },
    {
      "name": "proxy ios",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "args": [
        "--dart-define=useMitmProxy=true",
        "--dart-define=proxyUrl=127.0.0.1",
        "--dart-define=proxyPort=8080"
      ]
    },
    {
      "name": "flutter_tutorial (profile mode)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile"
    },
    {
      "name": "flutter_tutorial (release mode)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release"
    }
  ]
}
